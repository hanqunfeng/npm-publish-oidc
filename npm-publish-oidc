#!/usr/bin/env bash
# 通用的 npm OIDC 发布命令。
# 把本文件所在目录加入 PATH 后，可在任意项目根目录执行 npm-publish-oidc。
# 项目根目录始终是运行命令时的当前工作目录，不会切换到脚本所在目录。
#
# 本地只负责检查代码、提升版本和推送标签；真正的 npm publish 由项目里的
# GitHub Actions 工作流使用 npm Trusted Publishing（OIDC）完成。
#
# 用法:
#   npm-publish-oidc                 推送当前版本标签（不提升版本）
#   npm-publish-oidc patch           提升补丁版本并推送 commit + 标签
#   npm-publish-oidc minor           提升次版本并推送 commit + 标签
#   npm-publish-oidc major           提升主版本并推送 commit + 标签
#   npm-publish-oidc --check         只执行本地检查
#   npm-publish-oidc --dry-run       检查并显示计划操作
#   npm-publish-oidc --no-watch      推送后不等待 Actions
#   npm-publish-oidc --yes           确认发布计划后直接发布
#   npm-publish-oidc --workflow FILE 指定 .github/workflows 下的工作流文件名
#   npm-publish-oidc --init          缺少 publish.yml 时创建基础模板，不发布
#   npm-publish-oidc --zh            使用中文输出
#   npm-publish-oidc --help --zh     显示中文说明

# 遇到命令失败、未定义变量或管道中任一命令失败时立即退出。
set -euo pipefail

CMD_NAME="$(basename "$0")"
# 定位脚本真实所在目录，以便读取旁边的 publish.yml.tmpl。兼容符号链接。
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
	SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
	SOURCE="$(readlink "$SOURCE")"
	[[ "$SOURCE" != /* ]] && SOURCE="${SCRIPT_DIR}/${SOURCE}"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
unset SOURCE
# 包名、版本和仓库都从当前项目读取，不在脚本里写死。
PACKAGE=""
VERSION=""
HAS_BIN=0
GITHUB_REPO=""
WORKFLOW_FILE=""
# 网络查询和推送统一最多尝试 10 次，每次间隔 3 秒。
NETWORK_MAX_ATTEMPTS=10
NETWORK_RETRY_DELAY=3
# 默认等待工作流结束；--no-watch 会把该开关改为 false。
WATCH_WORKFLOW=true
# 正式发布前先展示计划并等待确认；--yes 跳过确认。
ASSUME_YES=false
# 默认英文输出；命令行带 --zh 时改为中文。
USE_ZH=false
# 发布前两项检查的失败标记。两项都跑完再退出，便于一次看到全部问题。
CHECK_FAILED=0

# 输出普通进度信息，并使用统一前缀方便阅读日志。
log() { echo "==> $*"; }

# 按 --zh 选择一句输出。第一个参数是英文，第二个参数是中文。
msg() {
	if [[ "$USE_ZH" == true ]]; then
		printf '%s\n' "$2"
	else
		printf '%s\n' "$1"
	fi
}

# 将致命错误写入标准错误并立即终止脚本。
die() {
	if [[ "$USE_ZH" == true ]]; then
		echo "错误: $*" >&2
	else
		echo "error: $*" >&2
	fi
	exit 1
}

# 记录一项发布前检查失败，但不立刻退出。
fail() {
	if [[ "$USE_ZH" == true ]]; then
		echo "错误: $*" >&2
	else
		echo "error: $*" >&2
	fi
	CHECK_FAILED=1
}

# 将非致命警告写入标准错误，但允许脚本继续执行。
warn() {
	if [[ "$USE_ZH" == true ]]; then
		echo "警告: $*" >&2
	else
		echo "warning: $*" >&2
	fi
}

# 执行可能因网络波动失败的命令，并按统一次数和间隔进行重试。
# 第一个参数是日志中的操作说明，剩余参数组成真正要执行的命令。
# 命令成功时返回 0；耗尽重试次数后返回 1。
retry_network() {
	local desc="$1"
	shift
	local attempt
	for ((attempt = 1; attempt <= NETWORK_MAX_ATTEMPTS; attempt++)); do
		if "$@"; then
			return 0
		fi
		if [[ $attempt -lt $NETWORK_MAX_ATTEMPTS ]]; then
			log "$(msg "Network operation failed, retrying ($attempt/$NETWORK_MAX_ATTEMPTS): $desc" "网络操作失败，重试 ($attempt/$NETWORK_MAX_ATTEMPTS): $desc")"
			sleep "$NETWORK_RETRY_DELAY"
		fi
	done
	return 1
}

# 输出命令行用法。--help 为英文，--help --zh 为中文。两者都可以在任意目录执行。
usage() {
	if [[ "${1:-en}" == "zh" ]]; then
		usage_zh
	else
		usage_en
	fi
}

usage_en() {
	cat <<EOF
Usage: $CMD_NAME [patch|minor|major] [options]

Run this in the project root. The current working directory is the project root.

  (no arguments)     Push the vX.Y.Z tag for the current package.json version and trigger an OIDC publish
  patch              Bump the patch version, then push (x.y.Z)
  minor              Bump the minor version, then push (x.Y.0)
  major              Bump the major version, then push (X.0.0)
  --check            Run local pre-publish checks only
  --dry-run          Check and preview the actions that would run, without pushing
  --no-watch         Do not wait for GitHub Actions after the push
  --yes, -y          Publish after showing the plan, without asking for confirmation
  --workflow FILE    Workflow filename under .github/workflows, for example publish.yml
  --init             Create a basic publish.yml template when it is missing. Does not publish
  --zh               Print messages in Chinese. With --help, show this help in Chinese
  --help             Show this help in English

Options can be combined with patch, minor, or major in any order. --init cannot be combined with other arguments.

The command first checks two things:
  1. The current directory can be published to npm:
     a valid package.json with a publishable name and version, and private is not true
  2. The current directory is the git repository root

Other requirements:
  Git: clean working tree, and origin points to a GitHub repository
  GitHub Actions: the workflow runs npm publish on a v* tag and declares id-token: write
  GitHub CLI: installed and signed in (gh auth login), used to watch the publish
  npm Trusted Publisher: configured for that GitHub repository and workflow filename

This command does not run npm publish locally. GitHub Actions publishes with OIDC.
EOF
}

