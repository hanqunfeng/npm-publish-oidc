# 通过 npm Trusted Publishing（OIDC）发布 __PACKAGE_NAME__。
# 前置条件：在 npmjs.com 为本包配置 Trusted Publisher：
# owner=__REPO_OWNER__、repo=__REPO_NAME__、workflow=publish.yml。
# 这是 npm-publish-oidc --init 生成的基础模板，请按项目需要修改后再提交。
name: Publish

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write
  id-token: write

concurrency:
  group: publish-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Setup Node.js
        uses: actions/setup-node@v6
        with:
          node-version: "24"
          registry-url: https://registry.npmjs.org
          package-manager-cache: false

      - name: Verify npm supports OIDC trusted publishing
        run: |
          node --version
          NPM_VERSION="$(npm --version)"
          echo "npm ${NPM_VERSION}"
          node -e "
            const [major, minor, patch] = process.argv[1].split('.').map(Number);
            if (major < 11 || (major === 11 && minor < 5) || (major === 11 && minor === 5 && patch < 1)) {
              console.error('npm ' + process.argv[1] + ' is too old; need >= 11.5.1 for OIDC trusted publishing');
              process.exit(1);
            }
          " "${NPM_VERSION}"

      - name: Verify tag matches package version
        if: startsWith(github.ref, 'refs/tags/')
        run: |
          TAG="${GITHUB_REF#refs/tags/}"
          VERSION=$(node -p "require('./package.json').version")
          if [ "v${VERSION}" != "${TAG}" ]; then
            echo "::error::Tag ${TAG} does not match package.json version ${VERSION}"
            exit 1
          fi
          echo "Publishing ${TAG} (package.json ${VERSION})"

      - name: Install dependencies
        run: npm ci

      - name: Test
        run: npm test

      - name: Preview package contents
        run: npm pack --dry-run

      - name: Publish to npm (OIDC)
        run: __PUBLISH_CMD__

      - name: Create GitHub Release
        if: startsWith(github.ref, 'refs/tags/')
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          TAG="${GITHUB_REF#refs/tags/}"
          REPO="${{ github.repository }}"
          if gh release view "${TAG}" --repo "${REPO}" >/dev/null 2>&1; then
            echo "Release ${TAG} already exists, skipping"
            exit 0
          fi
          gh release create "${TAG}" \
            --repo "${REPO}" \
            --title "${TAG}" \
            --generate-notes

      - name: Verify npm registry version
        run: |
          NAME=$(node -p "require('./package.json').name")
          VERSION=$(node -p "require('./package.json').version")
          for attempt in $(seq 1 20); do
            PUBLISHED=$(npm view "${NAME}" version --prefer-online 2>/dev/null || true)
            if [ "${PUBLISHED}" = "${VERSION}" ]; then
              echo "Verified ${NAME}@${VERSION} on npm"
              exit 0
            fi
            echo "Waiting for registry sync (${attempt}/20): npm=${PUBLISHED:-<none>} local=${VERSION}"
            sleep 3
          done
          echo "::warning::npm 注册表尚未同步到 ${VERSION}。包已发布，GitHub Release 已创建。"
          echo "::warning::复查：npm view ${NAME}@${VERSION} version"
